    "Scene.Report.StepFinal.TheyWillNoLongerBeAbleToFollowOrSeeYourPostsButTheyCanSeeIfTheyveBeenBlocked" : {
      "extractionState" : "migrated",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لَن يَتمكَّنَ بَعدَ الآنِ مِن مُتابَعَةِ مَنشوراتِكَ أو رُؤيَتِها، وَلكِن يُمكِنَهُ مَعرِفَةُ مَا إذا حُظَرِت عَنه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони більше не зможуть стежити або бачити Ваші пости, але вони зможуть побачити, що вони були заблоковані."
          }
        }
      }
    },
