    "Common.Alerts.BlockDomain.BlockEntireDomain" : {
      "extractionState" : "migrated",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حجب النطاق"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Block Domain"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Block Domain"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokuj domenę"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокувати домен"
          }
        }
      }
    },
    "Common.Alerts.BlockDomain.Title" : {
      "extractionState" : "migrated",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد تمامًا من رغبتك في حجب %@ بالكامل؟ في معظم الحالات، يكفي حجب أو كتم بعض الحسابات المحددة، بل ويُفضَّل ذلك. لن ترى أي محتوى من هذا النطاق، وسيتم حذف جميع متابعيك منه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you really, really sure you want to block the entire %@? In most cases a few targeted blocks or mutes are sufficient and preferable. You will not see content from that domain and any of your followers from that domain will be removed."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Are you really, really sure you want to block the entire %@? In most cases a few targeted blocks or mutes are sufficient and preferable. You will not see content from that domain and any of your followers from that domain will be removed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy jesteś zupełnie, całkowicie pewien, że chcesz zablokować całość %@? W większości wypadków wystarczy blokada lub wyciszenie kilku konkretnych profili. Nie będziesz widzieć zawartości z tej domeny i stracisz z niej wszystkich obserwujących."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви точно, точно впевнені, що хочете заблокувати весь домен %@? У більшості випадків для нормальної роботи краще заблокувати або приховати лише деяких користувачів. Ви не зможете бачити контент з цього домену у будь-яких стрічках або ваших сповіщеннях. Ваші підписники з цього домену будуть відписані від вас."
          }
        }
      }
    },
