    "Common.Alerts.ConfirmRemoveQuote.Message" : {
      "comment" : "Confirmation dialog when revoking quote permission.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم استبدال منشورك بالنص ’تم حذف المنشور من قِبَل المؤلف‘. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your post will be replaced with the text 'Post removed by author'. This action cannot be undone."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your post will be replaced with the text 'Post removed by author'. This action cannot be undone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój wpis zostanie zastąpiony tekstem „Wpis został usunięty przez autora”. Tej akcji nie można cofnąć."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш допис буде замінено на текст 'Допис видалено автором'. Цю дію не можна скасувати."
          }
        }
      }
    },
