    "Scene.Profile.HandleExplainerView.FederationExplainerText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Just like you can send emails to people using different email providers, you can interact with people on other Mastodon servers, and with anyone on other Fediverse apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just like you can send emails to people using different email providers, you can interact with people on other Mastodon servers, and with anyone on other Fediverse apps."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Just like you can send emails to people using different email providers, you can interact with people on other Mastodon servers, and with anyone on other Fediverse apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Just like you can send emails to people using different email providers, you can interact with people on other Mastodon servers, and with anyone on other Fediverse apps."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так само як ви можете надсилати електронні листи людям, які користуються різними поштовими сервісами, ви можете спілкуватися з користувачами інших серверів Mastodon, а також з будь-ким в інших застосунках Fediverse."
          }
        }
      }
    },
    "Scene.Profile.HandleExplainerView.ServerDetailWithExample" : {
