    },
    "Scene.Collections.collectionsExplainerLong" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح لك مزيّة المجموعات (التي ستتوفر في ماستودون ٤٫٦) إنشاء قوائمك الخاصة من الحسابات التي يمكنك التوصية بها للآخرين."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collections (coming in Mastodon 4.6) allow you to create your own curated lists of accounts to recommend to others."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collections (coming in Mastodon 4.6) allow you to create your own curated lists of accounts to recommend to others."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collections (coming in Mastodon 4.6) allow you to create your own curated lists of accounts to recommend to others."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колекції (очікуйте в Mastodon 4.6) дозволяють створювати власні списки облікових записів для інших."
          }
        }
      }
    },
    "Scene.Collections.collectionsExplainerShort" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجموعات قوائم مُنسَّقة من الحسابات لمساعدة الآخرين على اكتشاف المزيد من شبكة فيديفيرس."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collections are curated lists of accounts to help others discover more of the Fediverse."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collections are curated lists of accounts to help others discover more of the Fediverse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collections are curated lists of accounts to help others discover more of the Fediverse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колекції - це підібрані списки облікових записів, які допоможуть іншим дослідити більше Fediverse."
          }
        }
      }
    },
    "Scene.Collections.confirmRemoveFromCollectionMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن هذا الإجراء. سيظل بإمكان هذا المستخدم إضافتك إلى مجموعات أخرى، ما لم تحظره."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This action can’t be undone. This user will still be able to add you to other collections, unless you block them."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This action can’t be undone. This user will still be able to add you to other collections, unless you block them."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This action can’t be undone. This user will still be able to add you to other collections, unless you block them."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю дію скасувати не можна. Цей користувач все ще зможе додати вас до інших колекцій, якщо ви їх не заблокуєте."
          }
        }
      }
    },
