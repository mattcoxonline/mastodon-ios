    "Scene.EditProfile.VerifiedLinks.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adding the code to your header allows the <a> element to remain invisible. The rel=\\\"me\\\" attribute prevents impersonation on websites with user-generated content – so it’s important to keep it."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding the code to your header allows the <a> element to remain invisible. The rel=\\\"me\\\" attribute prevents impersonation on websites with user-generated content – so it’s important to keep it."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adding the code to your header allows the <a> element to remain invisible. The rel=\\\"me\\\" attribute prevents impersonation on websites with user-generated content – so it’s important to keep it."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adding the code to your header allows the <a> element to remain invisible. The rel=\\\"me\\\" attribute prevents impersonation on websites with user-generated content – so it’s important to keep it."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додавання коду до заголовка дозволяє елементу <a> залишатися невидимим. Атрибут rel=\\\"me\\\" запобігає імітуванню веб-сайтів з згенерованим користувачем вмістом - тому важливо зберегти його."
          }
        }
      }
    },
